SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://example.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=example_user
DB_PASSWORD=replace_with_local_secret
DB_PREPARE_THRESHOLD=0
FRONTEND_URL=http://localhost:3000
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_RECOVERY_EXPIRATION=15m
PASSWORD_RECOVERY_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_MAIL_FROM=no-reply@dentalcare.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_CUI=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=dentalcare-expedientes
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_CALL_TIMEOUT=30s
R2_API_CALL_ATTEMPT_TIMEOUT=15s
DOCUMENT_MAX_FILE_SIZE=10MB
DOCUMENT_MAX_REQUEST_SIZE=12MB
DOCUMENT_MAX_PART_COUNT=8
DOCUMENT_MAX_SWALLOW_SIZE=12MB
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_LOGIN_WINDOW=5m
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_LOGIN_IDENTITY=10
RATE_LIMIT_RECOVERY_WINDOW=1h
RATE_LIMIT_RECOVERY_IP=15
RATE_LIMIT_RECOVERY_IDENTITY=5
RATE_LIMIT_CONTACT_WINDOW=15m
RATE_LIMIT_CONTACT_IP=10
RATE_LIMIT_DOCUMENT_UPLOAD_WINDOW=1m
RATE_LIMIT_DOCUMENT_UPLOAD_IP=40
RATE_LIMIT_DOCUMENT_UPLOAD_IDENTITY=20
RATE_LIMIT_DOCUMENT_DOWNLOAD_WINDOW=1m
RATE_LIMIT_DOCUMENT_DOWNLOAD_IP=240
RATE_LIMIT_DOCUMENT_DOWNLOAD_IDENTITY=120
DOCUMENT_MAX_CONCURRENT_UPLOADS=4
DOCUMENT_MAX_CONCURRENT_DOWNLOADS=20

# Optional local monitoring. Set a unique password before enabling the profile.
GRAFANA_ADMIN_USER=monitor
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001

# Gemini AI Assistant
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_REQUEST_TIMEOUT=10s
GEMINI_DAILY_REQUEST_LIMIT=1000
RATE_LIMIT_ASSISTANT_WINDOW=15m
RATE_LIMIT_ASSISTANT_IP=20
