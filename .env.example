# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# Perfil y red
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL (Session Pooler)
DB_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=replace_with_local_secret
DB_PREPARE_THRESHOLD=0

# JWT (obligatorias: claves RSA en PEM, una sola linea con \n)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d

# Administrador inicial (activar solo en el primer arranque)
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_CUI=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Cloudflare R2 (documentos clinicos)
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=dentalcare-expedientes
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Asistente publico con Gemini (vacio = asistente desactivado, responde 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUSTED_PROXIES=

# Monitoreo local opcional (docker compose --profile monitoring up)
GRAFANA_ADMIN_USER=monitor
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
