{
  "uid": "dentalcare-backup",
  "title": "DentalCare backup laboratory",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Age of last complete backup",
      "datasource": {
        "type": "prometheus",
        "uid": "dentalcare-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "time() - dentalcare_backup_last_complete_timestamp_seconds",
          "refId": "A"
        }
      ],
      "description": "Historical completion time; does not prove ciphertext presence or current restorability."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Last operation result",
      "datasource": {
        "type": "prometheus",
        "uid": "dentalcare-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "dentalcare_backup_last_result",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last duration",
      "datasource": {
        "type": "prometheus",
        "uid": "dentalcare-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "dentalcare_backup_duration_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Age of verified restore",
      "datasource": {
        "type": "prometheus",
        "uid": "dentalcare-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "time() - dentalcare_backup_last_restore_timestamp_seconds",
          "refId": "A"
        }
      ],
      "description": "Historical successful restore rehearsal; not a current integrity guarantee for the latest set."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failures by stage",
      "datasource": {
        "type": "prometheus",
        "uid": "dentalcare-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "dentalcare_backup_failures_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latest ciphertext available (presence only)",
      "description": "1 = regular nonempty file within size limit; 0 = missing, invalid or inaccessible. No hash/decryption is performed.",
      "datasource": {
        "type": "prometheus",
        "uid": "dentalcare-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "dentalcare_backup_payload_available",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Present (not integrity verified)",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Unobserved"
        },
        "overrides": []
      }
    }
  ]
}
